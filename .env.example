# Copie para .env na raiz. Não coloque credenciais reais neste arquivo.
# Scraper: persistência e entrega de eventos são escolhas independentes.
PERSISTENCIA=postgres
FONTE_PRODUTOS=json
EVENTOS_TRANSPORTE=console

# Supabase > Connect > Session pooler (IPv4, processos persistentes), SSL obrigatório.
# Substitua REF, REGIAO e SENHA_CODIFICADA; codifique caracteres especiais da senha na URL.
DATABASE_URL=postgresql://postgres.REF:SENHA_CODIFICADA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
# Alternativa direta (requer IPv6 ou add-on IPv4):
# DATABASE_URL=postgresql://postgres:SENHA_CODIFICADA@db.REF.supabase.co:5432/postgres?sslmode=require

# Web: json mantém só links locais; postgres mostra as ofertas e histórico coletados.
CATALOG_SOURCE=postgres
# Python com psycopg instalado; padrão python3. Ajuste para caminho absoluto em produção.
SCRAPER_PYTHON=../services/scraper/.venv/bin/python
# PRODUCTS_FILE=/caminho/absoluto/services/scraper/produtos.json

# Usado somente quando EVENTOS_TRANSPORTE=redis (e pelo notifier Go).
REDIS_URL=redis://localhost:6379/0
# Necessários apenas para rodar o notifier; os testes de banco não usam estes valores.
TELEGRAM_BOT_TOKEN=coloque_o_token_aqui
TELEGRAM_CHAT_ID=coloque_o_chat_id_aqui

# Opcional: apenas banco LOCAL separado, com CREATEDB, para a suíte de integração.
# A suíte cria/remove bancos temporários; exige que o banco desta URL termine em _test.
# TEST_DATABASE_URL=postgresql://usuario@localhost:5432/bot_promocoes_test?sslmode=disable
