# Copie para .env na raiz do projeto e preencha. O .env nunca vai para o Git.
#   cp .env.example .env
# Scraper, notifier, web e docker compose leem este mesmo arquivo.
# Guia completo: docs/banco.md

# --- Banco oficial: Postgres no Docker (docker compose up -d postgres) --------
# Usuário e banco têm padrão "promo"; a senha é obrigatória e só existe aqui.
POSTGRES_USER=promo
POSTGRES_DB=promo
POSTGRES_PASSWORD=troque_esta_senha

# Conexão usada pelo scraper e pela web. Usuário, senha e banco iguais aos de cima.
DATABASE_URL=postgresql://promo:troque_esta_senha@127.0.0.1:5432/promo

# Supabase (banco de testes compartilhado): para usar, comente a linha de cima e
# descomente esta, com a URL do "Session pooler" do painel (Connect) e a senha
# do banco codificada (percent-encoding). Rode sempre com EVENTOS_TRANSPORTE=console.
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# --- Scraper ------------------------------------------------------------------
# postgres (padrão) guarda o estado; memoria esquece tudo ao reiniciar.
PERSISTENCIA=postgres
# json (padrão) lê services/scraper/produtos.json; postgres lê produtos_monitorados.
FONTE_PRODUTOS=json
# console (padrão, não envia nada), redis (vai para o Telegram) ou postgres (fila sem consumidor ainda).
# Só o banco oficial roda com redis.
EVENTOS_TRANSPORTE=console
# Minutos entre rodadas de coleta.
SCRAPER_INTERVALO_MINUTOS=30

# --- Redis (docker compose up -d redis) ---------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Notifier (Telegram) ------------------------------------------------------
# Veja services/notifier/README.md para criar o bot e descobrir o chat.
TELEGRAM_BOT_TOKEN=coloque_o_token_do_botfather
TELEGRAM_CHAT_ID=coloque_o_id_do_chat
# Pausa mínima entre mensagens, em segundos (padrão 1.1).
TELEGRAM_INTERVALO_SEGUNDOS=1.1

# --- Web (services/web) -------------------------------------------------------
# postgres ou json; vazio escolhe postgres quando há DATABASE_URL.
CATALOG_SOURCE=postgres
# Python com psycopg instalado, relativo a services/web.
# Windows (Git Bash): ../scraper/.venv/Scripts/python.exe
SCRAPER_PYTHON=../scraper/.venv/bin/python
# PRODUCTS_FILE=/caminho/absoluto/produtos.json

# --- Somente testes -----------------------------------------------------------
# Banco local separado, nome terminado em _test; os testes criam e apagam bancos
# próprios a partir dele. Nunca aponte para o banco oficial nem para o Supabase.
# TEST_DATABASE_URL=postgresql://promo:troque_esta_senha@127.0.0.1:5432/bot_promocoes_test?sslmode=disable
